# ============================================
# Dify API 调试文件
# ============================================
# 使用方式：
#   1. 先运行 login.ps1 获取最新 csrf_token
#      cd DebugTools && powershell .\login.ps1
#   2. 在 VS Code 中用 REST Client 插件打开本文件
#   3. 点击请求上方的 "Send Request" 按钮
#
# 注意：
#   - Console API 需要 csrf_token（由 login.ps1 写入 rest-client.env.json）
#   - App API 使用 App Token（从 Dify 控制台获取，无需登录）
# ============================================

@baseUrl = http://10.10.9.65

# ============================================
# 分区：App API（使用 App Token，无需登录）
# ============================================
@appToken = app-xc0lJvE8MRE4GiIWUF32eD3t

### 调用通用小助理
POST {{baseUrl}}/v1/chat-messages
Authorization: Bearer {{appToken}}
Content-Type: application/json

{
  "inputs": {
    "city": "北京"
  },
  "query": "颐和园大还是圆明园大",
  "response_mode": "streaming",
  "conversation_id": "",
  "user": "tengfei.ma",
  "files": []
}

### 获取应用信息
GET {{baseUrl}}/v1/info
Authorization: Bearer {{appToken}}

### 获取应用参数
GET {{baseUrl}}/v1/parameters
Authorization: Bearer {{appToken}}

### 获取应用元数据
GET {{baseUrl}}/v1/meta
Authorization: Bearer {{appToken}}

# ============================================
# 分区：Console API（需要先运行 login.ps1）
# csrf_token 由 login.ps1 自动写入 rest-client.env.json
# ============================================

### 登录（手动执行，确认登录成功）
POST {{baseUrl}}/console/api/login
Content-Type: application/json

{
  "email": "tengfei.ma@sinounion.com",
  "password": "bWV0MTk4NzQyOX4=",
  "language": "zh-Hans",
  "remember_me": true
}

### 获取应用列表
GET {{baseUrl}}/console/api/apps
x-csrf-token: {{csrf_token}}

### 获取应用详情
@appId = 5f079734-5179-48d5-aeec-0ffef6e481a7
GET {{baseUrl}}/console/api/apps/{{appId}}
x-csrf-token: {{csrf_token}}

### 获取应用站点信息
POST {{baseUrl}}/console/api/apps/{{appId}}/site
x-csrf-token: {{csrf_token}}

{
}

### 获取 MCP 工具列表
GET {{baseUrl}}/console/api/workspaces/current/tool-provider/mcp/tools/27c68c93-2354-4bf0-a093-56d4f5f58a9e
x-csrf-token: {{csrf_token}}
