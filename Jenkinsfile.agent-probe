// ============================================
// DCloud Market - Agent Probe Batch Deployment Pipeline
// Deploys the is-busy.py probe agent service to many Jenkins agent nodes
// (test machines) in parallel via DeployScripts/install_probe_service.ps1.
//
// Actions: install | update | uninstall | status | restart
// Token comes from Jenkins Credentials (id: probe-token), never hardcoded.
// WinSW is fetched from the LAN share; when USE_SHARE_CRED=true, domain
// credentials come from Jenkins Credentials (id: share-cred, type "Username
// with password") and are injected as SHARE_USER/SHARE_PASSWORD.
// ============================================

pipeline {
    agent none

    environment {
        PROBE_TOKEN = credentials('probe-token')
    }

    parameters {
        string(
            name: 'AGENTS',
            defaultValue: '',
            description: 'Comma-separated Jenkins node names to deploy to, e.g. "tengfei-test,win-agent-01" (required)'
        )
        choice(
            name: 'ACTION',
            choices: ['install', 'update', 'uninstall', 'status', 'restart'],
            description: 'Operation to run on every selected agent'
        )
        string(
            name: 'SERVER_URL',
            defaultValue: 'http://10.10.11.194:8000',
            description: 'Backend base URL (probe endpoint is appended: /api/test-machines/probe)'
        )
        string(
            name: 'IDLE_THRESHOLD_SEC',
            defaultValue: '300',
            description: 'Idle threshold for the busy verdict (seconds)'
        )
        string(
            name: 'INTERVAL_SEC',
            defaultValue: '30',
            description: 'Heartbeat interval when nothing changed (seconds)'
        )
        string(
            name: 'PYTHON_PATH',
            defaultValue: '',
            description: 'Optional full path to python.exe on the agents (auto-detected when empty)'
        )
        choice(
            name: 'USE_SHARE_CRED',
            choices: ['true', 'false'], // default = first choice ('true')
            description: 'Fetch WinSW via Jenkins credentials (id: share-cred, type: Username with password) when the agent account has no LAN share access'
        )
    }

    stages {
        stage('Validate') {
            steps {
                script {
                    def agents = (params.AGENTS ?: '').split(',').collect { it.trim() }.findAll { it }
                    if (!agents) {
                        error 'AGENTS parameter is required (comma-separated node names)'
                    }
                    echo "Dispatching ACTION=${params.ACTION} to ${agents.size()} agent(s): ${agents.join(', ')}"
                }
            }
        }

        stage('Dispatch') {
            steps {
                script {
                    def agents = (params.AGENTS ?: '').split(',').collect { it.trim() }.findAll { it }
                    def probeUrl = "${params.SERVER_URL}/api/test-machines/probe"
                    def useShareCred = (params.USE_SHARE_CRED == 'true')
                    def branches = [:]

                    for (agent in agents) {
                        branches[agent] = {
                            node(agent) {
                                try {
                                    checkout scm
                                    echo "[AGENT-PROBE] === ${agent}: ACTION=${params.ACTION} ==="
                                    def shareArgLine = ''
                                    def runProbe = {
                                        powershell """
                                            \$ErrorActionPreference = 'Stop'
                                            & '${env.WORKSPACE}\\DeployScripts\\install_probe_service.ps1' `
                                                -Action '${params.ACTION}' `
                                                -ServerUrl '${probeUrl}' `
                                                -Token \$env:PROBE_TOKEN `
                                                ${shareArgLine}-IntervalSec ${params.INTERVAL_SEC} `
                                                -IdleThresholdSec ${params.IDLE_THRESHOLD_SEC} `
                                                -PythonPath '${params.PYTHON_PATH}'
                                            if (\$LASTEXITCODE -ne 0) { exit \$LASTEXITCODE }
                                        """
                                    }
                                    if (useShareCred) {
                                        // Domain credentials for the LAN share; -SharePassword is
                                        // omitted on purpose (script falls back to SHARE_PASSWORD).
                                        withCredentials([usernamePassword(credentialsId: 'share-cred',
                                                                          usernameVariable: 'SHARE_USER',
                                                                          passwordVariable: 'SHARE_PASSWORD')]) {
                                            shareArgLine = '-ShareUser $env:SHARE_USER '
                                            runProbe()
                                        }
                                    } else {
                                        runProbe()
                                    }
                                    echo "[AGENT-PROBE] ${agent}: RESULT=PASS"
                                } catch (Exception e) {
                                    echo "[AGENT-PROBE] ${agent}: RESULT=FAIL - ${e.getMessage()}"
                                    throw e
                                } finally {
                                    cleanWs()
                                }
                            }
                        }
                    }

                    parallel branches
                }
            }
        }
    }

    post {
        always {
            echo "[AGENT-PROBE] Pipeline finished. Check per-agent RESULT=PASS/FAIL markers in the console log."
        }
        failure {
            echo "[AGENT-PROBE] One or more agents failed. Fix the failing agent(s) and re-run."
        }
    }
}
