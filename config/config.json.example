{
  "difyUrl": "http://10.10.9.65:80",
  "difyConsole": {
    "email": "your-email@example.com",
    "password": "your-base64-encoded-password"
  },
  "difyDatasetToken": "your-dataset-api-token",
  "databaseUrl": "sqlite:///C:/Data/skills.db",
  "uploadDir": "C:/Data/uploads",
  "dataDir": "C:/Data",
  "ldap": {
    "server": "ldap://your-domain-controller",
    "port": 389,
    "useSsl": false,
    "domain": "YOURDOMAIN",
    "baseDn": "DC=yourdomain,DC=com",
    "userPrefix": "YOURDOMAIN\\"
  },
  "jwtSecretKey": "change-me-to-a-random-secret",
  "jwtExpireHours": 168,
  "probeToken": "change-me-to-a-shared-probe-token",
  "probeOfflineAfterSeconds": 90,
  "probeAutoRegister": true
}